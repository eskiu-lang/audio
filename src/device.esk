// device.esk: sound output through SDL3. A program that imports it links
// SDL3; <audio/wav> and <audio/mixer> alone do not.
//
//     AudioDevice out = audio_open(48000)?;
//     defer out.close();
//     Mixer m = mixer_new(out.rate);
//     m.play(&music, AudioPlay{loop: true});
//     while (running) {
//         out.pump(&m, 50);    // keeps 50 ms of mixed audio queued
//         ...
//     }

import <mem>;
import <result>;
import <audio/mixer>;

#if defined(__wasm__) || defined(__ANDROID__) || defined(TARGET_OS_IPHONE)
#error "audio: <audio/device> runs on macOS, Linux and Windows for now; <audio/wav> and <audio/mixer> work everywhere"
#endif

#pragma link("SDL3")

struct _SdlSpec {
    uint32 format;
    int channels;
    int freq;
}

extern bool SDL_Init(uint32 flags);
extern void SDL_QuitSubSystem(uint32 flags);
extern string SDL_GetError();
extern *void SDL_OpenAudioDeviceStream(uint32 devid, *_SdlSpec spec, *void callback, *void userdata);
extern bool SDL_ResumeAudioStreamDevice(*void stream);
extern bool SDL_PauseAudioStreamDevice(*void stream);
extern bool SDL_PutAudioStreamData(*void stream, *void buf, int len);
extern int SDL_GetAudioStreamQueued(*void stream);
extern bool SDL_ClearAudioStream(*void stream);
extern void SDL_DestroyAudioStream(*void stream);

const uint32 _SDL_INIT_AUDIO = 0x10;
const uint32 _SDL_AUDIO_F32 = 0x8120;

// Stereo float output at rate frames per second.
struct AudioDevice {
    *void stream;
    int rate;
    *float scratch;
    int scratch_frames;
}

// Opens the default output device for stereo float samples at rate Hz (SDL
// converts to what the device wants).
Result<AudioDevice, string> audio_open(int rate) {
    if (!SDL_Init(_SDL_INIT_AUDIO)) return Err<AudioDevice, string>(SDL_GetError());
    _SdlSpec spec = _SdlSpec{_SDL_AUDIO_F32, 2, rate};
    *void stream = SDL_OpenAudioDeviceStream(0xFFFFFFFF, &spec, null, null);
    if (stream == null) {
        SDL_QuitSubSystem(_SDL_INIT_AUDIO);
        return Err<AudioDevice, string>(SDL_GetError());
    }
    SDL_ResumeAudioStreamDevice(stream);
    return Ok<AudioDevice, string>(AudioDevice{stream, rate, null, 0});
}

// Queues frames stereo frames (interleaved floats) for playback.
Result<int, string> AudioDevice_write(*AudioDevice self, *float samples, int frames) {
    if (!SDL_PutAudioStreamData(self.stream, samples, frames * 8)) return Err<int, string>(SDL_GetError());
    return Ok<int, string>(0);
}

// Frames queued and not yet played.
int AudioDevice_queued(*AudioDevice self) {
    int bytes = SDL_GetAudioStreamQueued(self.stream);
    return bytes < 0 ? 0 : bytes / 8;
}

// Mixes and queues enough of mixer to keep ahead_ms milliseconds queued;
// call it every frame of the program's loop.
Result<int, string> AudioDevice_pump(*AudioDevice self, *Mixer mixer, int ahead_ms) {
    int want = self.rate * ahead_ms / 1000;
    int missing = want - AudioDevice_queued(self);
    if (missing <= 0) return Ok<int, string>(0);
    if (missing > self.scratch_frames) {
        if (self.scratch != null) free(self.scratch);
        self.scratch = alloc<float>(missing * 2);
        self.scratch_frames = missing;
    }
    Mixer_render(mixer, self.scratch, missing);
    return AudioDevice_write(self, self.scratch, missing);
}

void AudioDevice_pause(*AudioDevice self) {
    SDL_PauseAudioStreamDevice(self.stream);
}

void AudioDevice_resume(*AudioDevice self) {
    SDL_ResumeAudioStreamDevice(self.stream);
}

// Drops what is queued and not yet played.
void AudioDevice_clear(*AudioDevice self) {
    SDL_ClearAudioStream(self.stream);
}

void AudioDevice_close(*AudioDevice self) {
    if (self.stream != null) {
        SDL_DestroyAudioStream(self.stream);
        SDL_QuitSubSystem(_SDL_INIT_AUDIO);
    }
    if (self.scratch != null) free(self.scratch);
    self.stream = null;
    self.scratch = null;
}
