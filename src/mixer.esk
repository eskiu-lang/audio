// mixer.esk: mixes playing sounds and streams into a stereo float stream.
//
//     Mixer m = mixer_new(48000);
//     uint32 id = m.play(&jump, AudioPlay{volume: 0.8, pan: -0.3});
//     m.render(out, 512);      // 512 stereo frames, interleaved
//
// Each voice reads its sound at its own rate and pitch (linear
// interpolation), with volume, pan (-1 left to 1 right, equal power) and
// looping. A mono sound plays on both sides; a sound with more than two
// channels plays its first two. The sounds must live while they play.
//
// A voice can also play an AudioSource, a stream that renders itself (a
// sequencer, a decoder), and every voice plays on a bus: master, music,
// sfx, or one added with Mixer_add_bus. Voices and buses fade over a time
// in milliseconds, linearly in gain. Mixer_use_bgm, Mixer_use_me and
// Mixer_use_bgs give voices the roles of a game's background music, a
// fanfare that pauses that music while it plays, and background sound.
//
// The output depends only on the calls made and the frame counts rendered,
// never on wall time: rendering 4096 frames, or the same 4096 in blocks of
// 1 or 7, gives the same samples (Mixer_advance runs the timers on a video
// clock instead).

import <mem>;
import <list>;
import <libc>;
import <audio/wav>;

// A stream the mixer plays: render writes up to frames stereo frames
// (2 * frames floats, interleaved, at the mixer's rate) into out and
// returns how many it wrote; done says no more will come. A source that
// writes fewer frames and is not done plays silence for the rest.
interface AudioSource {
    int64 render(*float out, int64 frames);
    bool done();
}

// The buses every mixer has: master (everything ends there), music and sfx (both under
// master). Mixer_add_bus adds more.
const int AUDIO_BUS_MASTER = 0;
// The music bus, under master.
const int AUDIO_BUS_MUSIC = 1;
// The sound effects bus, under master.
const int AUDIO_BUS_SFX = 2;

// Frames a source renders at a time, whatever the size of the mix.
const int64 _MIX_CHUNK = 512;

// How Mixer_play plays a sound: volume (1 is the sound as recorded), pan (-1 left to 1
// right, equal power), pitch (2 is an octave up and twice as fast), loop, reverse, and the
// bus it plays on (master by default).
struct AudioPlay {
    float volume = 1.0;
    float pan;
    float pitch = 1.0;
    bool loop;
    bool reverse;
    // Pan as stereo balance: centered, both channels play at full volume.
    bool balance;
    int bus;
}

// A point or direction in the listener's world: x right, y up, -z ahead (ViroReact's
// axes).
struct AudioVec3 {
    float x;
    float y;
    float z;
}

// A rotation (x, y, z vector part, w scalar part), as gpu's Quat.
struct AudioQuat {
    float x;
    float y;
    float z;
    float w = 1.0;
}

// How a positioned sound fades with distance (ViroReact's rolloffModel): not at all, in a
// straight line from min_distance to silence at max_distance, or along 1 / (d + 1) from
// min_distance, shifted to reach silence at max_distance. Distances under 1 count as 1, and
// past max_distance the sound is silent (Resonance Audio's curves, which ViroReact plays
// through).
const int AUDIO_ROLLOFF_NONE = 0;
// Linear fall from min_distance to silence at max_distance.
const int AUDIO_ROLLOFF_LINEAR = 1;
// 1 / (d + 1) from min_distance, reaching silence at max_distance.
const int AUDIO_ROLLOFF_LOGARITHMIC = 2;

const int _SPACE_NONE = 0;
const int _SPACE_POINT = 1;
const int _SPACE_FIELD = 2;

struct _Voice {
    uint32 id;
    *Sound sound;
    double pos;
    double step;
    float left;
    float right;
    float volume;
    float pan;
    float space_gain;
    float space_pan;
    bool loop;
    float pitch;
    *Sound next;
    bool next_loop;
    bool paused;
    bool reverse;
    bool balance;
    int bus;
    double env;
    double env_target;
    double env_speed;
    bool env_stop;
    bool ended;
    bool is_src;
    AudioSource src;
    *float buf;
    int64 buf_len;
    int64 buf_pos;
    bool src_done;
    uint64 played;
    int space;
    AudioVec3 position;
    int rolloff;
    float min_distance;
    float max_distance;
    AudioQuat field_rotation;
    float kx;
    float ky;
    float kz;
}

struct _Bus {
    int parent;
    double gain;
    double target;
    double speed;
    float eff;
}

// Mixes the voices into stereo float frames at `rate` Hz. volume scales the whole mix;
// mono mixes both channels to the same signal. Make one with mixer_new.
struct Mixer {
    int rate;
    float volume;
    List<_Voice> voices;
    uint32 next_id;
    List<_Bus> buses;
    bool mono;
    bool manual_clock;
    uint32 bgm;
    uint32 me;
    uint32 bgs;
    AudioVec3 listener;
    AudioVec3 listener_forward;
    AudioVec3 listener_up;
}

// A mixer with no voices for output at rate frames per second, with the master, music and
// sfx buses.
Mixer mixer_new(int rate) {
    Mixer m;
    m.rate = rate;
    m.volume = 1.0;
    m.next_id = 1;
    m.listener_forward = AudioVec3{0.0, 0.0, -1.0};
    m.listener_up = AudioVec3{0.0, 1.0, 0.0};
    List_push(&m.buses, _Bus{parent: -1, gain: 1.0, target: 1.0});
    List_push(&m.buses, _Bus{parent: AUDIO_BUS_MASTER, gain: 1.0, target: 1.0});
    List_push(&m.buses, _Bus{parent: AUDIO_BUS_MASTER, gain: 1.0, target: 1.0});
    return m;
}

void _voice_gains(_Voice* v) {
    if (v.space == _SPACE_FIELD) {
        v.left = v.volume;
        v.right = v.volume;
        return;
    }
    float p = v.space == _SPACE_POINT ? v.space_pan : v.pan;
    float vol = v.space == _SPACE_POINT ? v.volume * v.space_gain : v.volume;
    float pan = p < -1.0 ? -1.0 : (p > 1.0 ? 1.0 : p);
    if (v.space == _SPACE_POINT) {
        double a = ((double)pan + 1.0) * 0.7853981633974483;
        v.left = vol * (float)cos(a);
        v.right = vol * (float)sin(a);
        return;
    }
    if (v.balance) {
        v.left = v.volume * (pan > 0.0 ? 1.0 - pan : 1.0);
        v.right = v.volume * (pan < 0.0 ? 1.0 + pan : 1.0);
        return;
    }
    double angle = ((double)pan + 1.0) * 0.7853981633974483;
    v.left = v.volume * (float)cos(angle);
    v.right = v.volume * (float)sin(angle);
}

int _mixer_bus_of(*Mixer self, int bus) {
    return bus >= 0 && bus < self.buses.size ? bus : 0;
}

uint32 _mixer_add(*Mixer self, _Voice v, AudioPlay opt) {
    v.id = self.next_id;
    self.next_id++;
    if (self.next_id == 0) self.next_id = 1;
    v.volume = opt.volume;
    v.pan = opt.pan;
    v.balance = opt.balance;
    v.bus = _mixer_bus_of(self, opt.bus);
    v.env = 1.0;
    v.env_target = 1.0;
    _voice_gains(&v);
    List_push(&self.voices, v);
    return v.id;
}

// Starts sound and returns its voice id. AudioPlay{} plays at full volume,
// centered, at the sound's own pitch, once, on the master bus. pitch is
// also the speed (a cry at 1.5 plays faster and higher); reverse plays the
// sound from its end to its start.
uint32 Mixer_play(*Mixer self, *Sound sound, AudioPlay opt) {
    _Voice v;
    v.sound = sound;
    float pitch = opt.pitch > 0.0 ? opt.pitch : 1.0;
    v.pitch = pitch;
    v.step = (double)pitch * (double)sound.rate / (double)self.rate;
    v.loop = opt.loop;
    v.reverse = opt.reverse;
    return _mixer_add(self, v, opt);
}

// Starts a stream and returns its voice id. The source must live while it
// plays; it renders at the mixer's rate, so pitch, loop and reverse do not
// apply, and its pan is a stereo balance.
uint32 Mixer_play_source(*Mixer self, AudioSource src, AudioPlay opt) {
    _Voice v;
    v.is_src = true;
    v.src = src;
    v.buf = alloc<float>(_MIX_CHUNK * 2);
    opt.balance = true;
    return _mixer_add(self, v, opt);
}

_Voice* _mixer_voice(*Mixer self, uint32 id) {
    for (i in 0..self.voices.size) {
        _Voice* v = &self.voices.data[i];
        if (v.id == id && !v.ended) return v;
    }
    return null;
}

// Whether the voice `id` is still playing (paused counts as playing).
bool Mixer_playing(*Mixer self, uint32 id) {
    return _mixer_voice(self, id) != null;
}

// Removes the voice at k, keeping the others in the order they started:
// the mix adds voices in that order, so it never depends on when one ends.
void _mixer_remove(*Mixer self, int k) {
    if (self.voices.data[k].buf != null) free(self.voices.data[k].buf);
    for (i in k..self.voices.size - 1) self.voices.data[i] = self.voices.data[i + 1];
    self.voices.size--;
}

// Stops the voice `id` at once; an unknown id does nothing.
void Mixer_stop(*Mixer self, uint32 id) {
    for (i in 0..self.voices.size) {
        if (self.voices.data[i].id == id) {
            _mixer_remove(self, i);
            return;
        }
    }
}

// Stops every voice.
void Mixer_stop_all(*Mixer self) {
    for (i in 0..self.voices.size) {
        if (self.voices.data[i].buf != null) free(self.voices.data[i].buf);
    }
    self.voices.size = 0;
}

// Sets the voice's volume (1 is the sound as recorded).
void Mixer_set_volume(*Mixer self, uint32 id, float volume) {
    _Voice* v = _mixer_voice(self, id);
    if (v == null) return;
    v.volume = volume;
    _voice_gains(v);
}

// Sets the voice's pan, from -1 (left) to 1 (right).
void Mixer_set_pan(*Mixer self, uint32 id, float pan) {
    _Voice* v = _mixer_voice(self, id);
    if (v == null) return;
    v.pan = pan;
    _voice_gains(v);
}

// Sets the voice's pitch (1 is the sound's own rate, 2 an octave up); a stream's pitch
// does not change, and a pitch of 0 or less is ignored.
void Mixer_set_pitch(*Mixer self, uint32 id, float pitch) {
    _Voice* v = _mixer_voice(self, id);
    if (v == null || v.is_src || pitch <= 0.0) return;
    v.pitch = pitch;
    v.step = (double)pitch * (double)v.sound.rate / (double)self.rate;
}

// When the voice's sound ends, `sound` follows it with no gap, looping or not: an intro
// then its loop. A later call replaces what follows; a looping voice never ends, so nothing
// follows it.
void Mixer_then(*Mixer self, uint32 id, *Sound sound, bool loop) {
    _Voice* v = _mixer_voice(self, id);
    if (v == null || v.is_src) return;
    v.next = sound;
    v.next_loop = loop;
}

// The sound the voice is playing now (the one that followed, after Mixer_then), or null.
*Sound Mixer_current(*Mixer self, uint32 id) {
    _Voice* v = _mixer_voice(self, id);
    return v == null ? null : v.sound;
}

// Where the voice is in its current sound, in seconds, or -1 when it is not playing. A
// stream's position is the time it has played.
double Mixer_position(*Mixer self, uint32 id) {
    _Voice* v = _mixer_voice(self, id);
    if (v == null) return -1.0;
    if (v.is_src) return (double)v.played / (double)self.rate;
    return v.pos / (double)v.sound.rate;
}

// Moves the voice to `seconds` into its current sound (not a stream).
void Mixer_seek(*Mixer self, uint32 id, double seconds) {
    _Voice* v = _mixer_voice(self, id);
    if (v == null || v.is_src) return;
    double at = seconds * (double)v.sound.rate;
    v.pos = at < 0 ? 0 : (at >= (double)v.sound.frames ? (double)v.sound.frames - 1 : at);
}

// A paused voice keeps its place and adds nothing to the mix until it is resumed.
void Mixer_pause(*Mixer self, uint32 id) {
    _Voice* v = _mixer_voice(self, id);
    if (v != null) v.paused = true;
}

// Resumes a voice paused with Mixer_pause from where it was.
void Mixer_resume(*Mixer self, uint32 id) {
    _Voice* v = _mixer_voice(self, id);
    if (v != null) v.paused = false;
}

// Whether the voice `id` is paused.
bool Mixer_paused(*Mixer self, uint32 id) {
    _Voice* v = _mixer_voice(self, id);
    return v != null && v.paused;
}

// The number of voices playing, paused ones included.
int Mixer_count(*Mixer self) {
    return self.voices.size;
}

// A fade moves a gain linearly from where it is to a target over ms
// milliseconds (at once for 0), at a fixed speed in gain per second.
void _env_to(*double gain, *double target, *double speed, double to, int ms) {
    *target = to;
    if (ms <= 0) {
        *gain = to;
        *speed = 0.0;
        return;
    }
    double d = fabs(to - *gain);
    *speed = (d > 0.001 ? d : 0.001) / ((double)ms / 1000.0);
}

void _env_step(*double gain, double target, double speed, double dt) {
    if (*gain == target) return;
    double d = speed * dt;
    if (*gain < target) *gain = *gain + d < target ? *gain + d : target;
    else *gain = *gain - d > target ? *gain - d : target;
}

// Moves the voice's fade gain (1 when it starts, a factor on its volume) to gain over ms.
void Mixer_fade(*Mixer self, uint32 id, float gain, int ms) {
    _Voice* v = _mixer_voice(self, id);
    if (v == null) return;
    v.env_stop = false;
    _env_to(&v.env, &v.env_target, &v.env_speed, (double)gain, ms);
}

// Fades the voice from silence to full over ms.
void Mixer_fade_in(*Mixer self, uint32 id, int ms) {
    _Voice* v = _mixer_voice(self, id);
    if (v == null) return;
    v.env = ms > 0 ? 0.0 : 1.0;
    v.env_stop = false;
    _env_to(&v.env, &v.env_target, &v.env_speed, 1.0, ms);
}

// Fades the voice to silence over ms and stops it there (at once for 0).
void Mixer_fade_out(*Mixer self, uint32 id, int ms) {
    _Voice* v = _mixer_voice(self, id);
    if (v == null) return;
    if (ms <= 0) {
        Mixer_stop(self, id);
        return;
    }
    v.env_stop = true;
    _env_to(&v.env, &v.env_target, &v.env_speed, 0.0, ms);
}

// `from` fades out and stops while `to` fades in, both over ms: their gains add up to 1.
void Mixer_crossfade(*Mixer self, uint32 from, uint32 to, int ms) {
    Mixer_fade_in(self, to, ms);
    Mixer_fade_out(self, from, ms);
}

// The voice's fade gain now, or -1 when it is not playing.
double Mixer_fade_level(*Mixer self, uint32 id) {
    _Voice* v = _mixer_voice(self, id);
    return v == null ? -1.0 : v.env;
}

// A new bus inside parent (AUDIO_BUS_MASTER for a top-level category); returns its index.
// A voice's gain is its volume times its fade times the volume of its bus and of each bus
// that holds it.
int Mixer_add_bus(*Mixer self, int parent) {
    List_push(&self.buses, _Bus{parent: _mixer_bus_of(self, parent), gain: 1.0, target: 1.0});
    return self.buses.size - 1;
}

// Sets the bus's volume at once (1 leaves it unchanged); the bus scales every voice and
// bus under it.
void Mixer_set_bus_volume(*Mixer self, int bus, float volume) {
    if (bus < 0 || bus >= self.buses.size) return;
    _Bus* b = &self.buses.data[bus];
    _env_to(&b.gain, &b.target, &b.speed, (double)volume, 0);
}

// Moves the bus's volume to volume over ms, like a voice's fade.
void Mixer_fade_bus(*Mixer self, int bus, float volume, int ms) {
    if (bus < 0 || bus >= self.buses.size) return;
    _Bus* b = &self.buses.data[bus];
    _env_to(&b.gain, &b.target, &b.speed, (double)volume, ms);
}

// The bus's volume now (in the middle of a fade, where the fade is), or 0 for an unknown
// bus.
float Mixer_bus_volume(*Mixer self, int bus) {
    if (bus < 0 || bus >= self.buses.size) return 0.0;
    return (float)self.buses.data[bus].gain;
}

// Moves a playing voice to another bus.
void Mixer_set_bus(*Mixer self, uint32 id, int bus) {
    _Voice* v = _mixer_voice(self, id);
    if (v != null) v.bus = _mixer_bus_of(self, bus);
}

// Mono output: each frame plays the average of its two channels on both sides.
void Mixer_set_mono(*Mixer self, bool mono) {
    self.mono = mono;
}

// Makes the voice the background music. The music before it fades out and stops while this
// one fades in, over fade_ms (with 0 the old one stops and this one plays at once); while a
// fanfare plays, the new music waits paused. Given the voice that is already the music, it
// only fades it back to full over fade_ms.
void Mixer_use_bgm(*Mixer self, uint32 id, int fade_ms) {
    _Voice* v = _mixer_voice(self, id);
    if (v == null) return;
    if (id == self.bgm) {
        Mixer_fade(self, id, 1.0, fade_ms);
        return;
    }
    Mixer_fade_in(self, id, fade_ms);
    if (Mixer_playing(self, self.me)) v.paused = true;
    uint32 old = self.bgm;
    self.bgm = id;
    if (old != 0) Mixer_fade_out(self, old, fade_ms);
}

// Fades the background music out over fade_ms and stops it (at once for 0).
void Mixer_stop_bgm(*Mixer self, int fade_ms) {
    uint32 old = self.bgm;
    self.bgm = 0;
    if (old != 0) Mixer_fade_out(self, old, fade_ms);
}

// Makes the voice the fanfare (ME): the background music pauses where it is and resumes on
// the frame after the fanfare ends or stops. A new fanfare stops the one before.
void Mixer_use_me(*Mixer self, uint32 id) {
    if (_mixer_voice(self, id) == null) return;
    if (self.me != 0 && self.me != id) Mixer_stop(self, self.me);
    self.me = id;
    Mixer_pause(self, self.bgm);
}

// Makes the voice the background sound (BGS), stopping the one before.
void Mixer_use_bgs(*Mixer self, uint32 id) {
    if (_mixer_voice(self, id) == null) return;
    if (self.bgs != 0 && self.bgs != id) Mixer_stop(self, self.bgs);
    self.bgs = id;
}

// Stops the background sound, if one plays.
void Mixer_stop_bgs(*Mixer self) {
    if (self.bgs != 0) Mixer_stop(self, self.bgs);
    self.bgs = 0;
}

// The voice in each role, or 0 when none plays.
uint32 Mixer_bgm(*Mixer self) {
    return Mixer_playing(self, self.bgm) ? self.bgm : 0;
}

// The fanfare voice, or 0 when none plays.
uint32 Mixer_me(*Mixer self) {
    return Mixer_playing(self, self.me) ? self.me : 0;
}

// The background sound voice, or 0 when none plays.
uint32 Mixer_bgs(*Mixer self) {
    return Mixer_playing(self, self.bgs) ? self.bgs : 0;
}

// Fades and the fanfare's end are timers. By default they run on the
// frames rendered, sample by sample. With the manual clock they run only
// in Mixer_advance, and a render mixes at the gains the last advance left:
// a video recorder calls m.advance(dt) and then m.render(out, frames) for
// each video frame.
void Mixer_set_manual_clock(*Mixer self, bool manual) {
    self.manual_clock = manual;
}

// After a fanfare ends or stops, the music it paused resumes.
void _mixer_events(*Mixer self) {
    if (self.me == 0 || Mixer_playing(self, self.me)) return;
    self.me = 0;
    Mixer_resume(self, self.bgm);
}

// Moves every fade by dt seconds; a voice faded out to silence ends.
void _mixer_tick(*Mixer self, double dt) {
    for (b in 0..self.buses.size) {
        _Bus* bus = &self.buses.data[b];
        _env_step(&bus.gain, bus.target, bus.speed, dt);
    }
    for (k in 0..self.voices.size) {
        _Voice* v = &self.voices.data[k];
        if (v.ended) continue;
        _env_step(&v.env, v.env_target, v.env_speed, dt);
        if (v.env_stop && v.env <= 0.0) v.ended = true;
    }
}

void _mixer_sweep(*Mixer self) {
    int k = 0;
    while (k < self.voices.size) {
        if (self.voices.data[k].ended) _mixer_remove(self, k);
        else k++;
    }
}

// With the manual clock, runs the timers dt seconds of the caller's clock forward in one
// step (a video frame). Without it the rendered frames are the clock and this does nothing.
void Mixer_advance(*Mixer self, double dt) {
    if (!self.manual_clock) return;
    _mixer_tick(self, dt);
    _mixer_sweep(self);
    _mixer_events(self);
}

float _sample(*Sound s, uint64 frame, int ch) {
    int c = ch < s.channels ? ch : s.channels - 1;
    return s.data[frame * (uint64)s.channels + (uint64)c];
}

// One frame of a sound voice into l and r (before its gains), then a step forward; false
// when there is nothing to play.
bool _voice_sound_frame(*Mixer self, _Voice* v, *float l, *float r) {
    *Sound s = v.sound;
    if (s.frames == 0) return false;
    // A looping voice wraps from the sound's loop end to its loop start (the whole sound
    // without loop points, or when it plays backwards).
    uint64 ls = 0;
    uint64 le = s.frames;
    if (v.loop && !v.reverse && s.loop_end > s.loop_start && s.loop_end <= s.frames) {
        ls = s.loop_start;
        le = s.loop_end;
    }
    uint64 i0 = (uint64)v.pos;
    double t = v.pos - (double)i0;
    uint64 i1 = i0 + 1;
    if (i1 >= le) i1 = v.loop ? ls : i0;
    if (v.reverse) {
        i0 = s.frames - 1 - i0;
        i1 = s.frames - 1 - i1;
    }
    float l0 = _sample(s, i0, 0);
    float l1 = _sample(s, i1, 0);
    float r0 = _sample(s, i0, 1);
    float r1 = _sample(s, i1, 1);
    *l = l0 + (l1 - l0) * (float)t;
    *r = r0 + (r1 - r0) * (float)t;
    if (v.space == _SPACE_POINT) {
        // a positioned sound is a point: its channels mixed to one
        float c = (*l + *r) * 0.5;
        *l = c;
        *r = c;
    } else if (v.space == _SPACE_FIELD && s.channels >= 4) {
        // first-order AmbiX (W, Y, Z, X): a virtual cardioid toward each ear
        float w0 = l0;
        float w = w0 + (l1 - w0) * (float)t;
        float y = r0 + (r1 - r0) * (float)t;
        float z0 = _sample(s, i0, 2);
        float z = z0 + (_sample(s, i1, 2) - z0) * (float)t;
        float x0 = _sample(s, i0, 3);
        float x = x0 + (_sample(s, i1, 3) - x0) * (float)t;
        float side = v.kx * x + v.ky * y + v.kz * z;
        *l = 0.5 * (w + side);
        *r = 0.5 * (w - side);
    }
    v.pos = v.pos + v.step;
    if (v.loop && v.pos >= (double)le) {
        double span = (double)(le - ls);
        double p = v.pos - (double)ls;
        v.pos = (double)ls + (p - span * (double)(uint64)(p / span));
    } else if (v.pos >= (double)s.frames) {
        if (v.next != null && v.next.frames > 0) {
            // What is left over carries into the next sound, at its rate.
            double over = (v.pos - (double)s.frames) / (double)s.rate * (double)v.next.rate;
            v.sound = v.next;
            v.loop = v.next_loop;
            v.next = null;
            v.step = (double)v.pitch * (double)v.sound.rate / (double)self.rate;
            v.pos = over < (double)v.sound.frames ? over : 0;
        }
        else v.ended = true;
    }
    return true;
}

// One frame of a stream. The source is asked for _MIX_CHUNK frames at a time, so the calls
// it sees do not depend on how the mix is split into renders.
bool _voice_source_frame(_Voice* v, *float l, *float r) {
    if (v.buf_pos >= v.buf_len) {
        if (v.src_done) return false;
        int64 n = v.src.render(v.buf, _MIX_CHUNK);
        if (n < 0) n = 0;
        if (n > _MIX_CHUNK) n = _MIX_CHUNK;
        v.src_done = v.src.done();
        if (!v.src_done) {
            for (i in n * 2.._MIX_CHUNK * 2) v.buf[i] = 0.0;
            n = _MIX_CHUNK;
        }
        v.buf_len = n;
        v.buf_pos = 0;
        if (n == 0) return false;
    }
    *l = v.buf[v.buf_pos * 2];
    *r = v.buf[v.buf_pos * 2 + 1];
    v.buf_pos++;
    if (v.src_done && v.buf_pos >= v.buf_len) v.ended = true;
    return true;
}

// Writes frames stereo frames (2 * frames floats) of the mix into out and
// advances every voice; voices that end are removed. Voices add in the
// order they started.
void Mixer_render(*Mixer self, *float out, int frames) {
    double dt = 1.0 / (double)self.rate;
    for (f in 0..frames) {
        if (!self.manual_clock) _mixer_events(self);
        for (b in 0..self.buses.size) {
            _Bus* bus = &self.buses.data[b];
            bus.eff = (float)bus.gain;
            if (bus.parent >= 0 && bus.parent < b) bus.eff = bus.eff * self.buses.data[bus.parent].eff;
        }
        float sl = 0.0;
        float sr = 0.0;
        for (k in 0..self.voices.size) {
            _Voice* v = &self.voices.data[k];
            if (v.paused || v.ended) continue;
            float l = 0.0;
            float r = 0.0;
            bool got = v.is_src ? _voice_source_frame(v, &l, &r) : _voice_sound_frame(self, v, &l, &r);
            if (!got) {
                v.ended = true;
                continue;
            }
            v.played++;
            float g = (float)v.env;
            if (self.buses.size > 0) g = g * self.buses.data[v.bus].eff;
            sl += l * v.left * g;
            sr += r * v.right * g;
        }
        if (self.mono) {
            sl = (sl + sr) * 0.5;
            sr = sl;
        }
        float x = sl * self.volume;
        float y = sr * self.volume;
        out[f * 2] = x > 1.0 ? 1.0 : (x < -1.0 ? -1.0 : x);
        out[f * 2 + 1] = y > 1.0 ? 1.0 : (y < -1.0 ? -1.0 : y);
        if (!self.manual_clock) _mixer_tick(self, dt);
    }
    _mixer_sweep(self);
    if (!self.manual_clock) _mixer_events(self);
}

// --- sound in space ---

float _v3_dot(AudioVec3 a, AudioVec3 b) {
    return a.x * b.x + a.y * b.y + a.z * b.z;
}

AudioVec3 _v3_cross(AudioVec3 a, AudioVec3 b) {
    return AudioVec3{a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x};
}

AudioVec3 _v3_unit(AudioVec3 a) {
    float l = (float)sqrt((double)_v3_dot(a, a));
    if (l < 1e-9) return AudioVec3{0.0, 0.0, 0.0};
    return AudioVec3{a.x / l, a.y / l, a.z / l};
}

AudioVec3 _quat_rotate(AudioQuat q, AudioVec3 v) {
    AudioVec3 u = AudioVec3{q.x, q.y, q.z};
    AudioVec3 t = _v3_cross(u, v);
    t = AudioVec3{t.x * 2.0, t.y * 2.0, t.z * 2.0};
    AudioVec3 c = _v3_cross(u, t);
    return AudioVec3{v.x + q.w * t.x + c.x, v.y + q.w * t.y + c.y, v.z + q.w * t.z + c.z};
}

// The gain of a positioned sound at distance from the listener, for a rolloff model
// (Resonance Audio's distance attenuation).
float audio_rolloff_gain(int model, float distance, float min_distance, float max_distance) {
    if (model == AUDIO_ROLLOFF_NONE) return 1.0;
    if (distance > max_distance) return 0.0;
    float near = min_distance > 1.0 ? min_distance : 1.0;
    if (distance <= near) return 1.0;
    float span = max_distance - near;
    if (span <= 1e-6) return 1.0;
    if (model == AUDIO_ROLLOFF_LINEAR) return (max_distance - distance) / span;
    float g = 1.0 / (distance - near + 1.0);
    float floor_g = 1.0 / (span + 1.0);
    return (g - floor_g) / (1.0 - floor_g);
}

AudioVec3 _listener_right(*Mixer self) {
    return _v3_unit(_v3_cross(self.listener_forward, self.listener_up));
}

void _voice_space(*Mixer self, _Voice* v) {
    if (v.space == _SPACE_POINT) {
        AudioVec3 d = AudioVec3{v.position.x - self.listener.x, v.position.y - self.listener.y, v.position.z - self.listener.z};
        float dist = (float)sqrt((double)_v3_dot(d, d));
        v.space_gain = audio_rolloff_gain(v.rolloff, dist, v.min_distance, v.max_distance);
        v.space_pan = dist > 1e-6 ? _v3_dot(_v3_unit(d), _listener_right(self)) : 0.0;
    } else if (v.space == _SPACE_FIELD) {
        // the listener's left in the field's own axes, then in AmbiX's (x ahead, y left, z up)
        AudioVec3 left = _listener_right(self);
        left = AudioVec3{-left.x, -left.y, -left.z};
        AudioQuat q = v.field_rotation;
        AudioVec3 local = _quat_rotate(AudioQuat{-q.x, -q.y, -q.z, q.w}, left);
        v.kx = -local.z;
        v.ky = -local.x;
        v.kz = local.y;
    }
    _voice_gains(v);
}

// Places the listener (the camera): its position, the direction it faces and its up.
// Positioned sounds and sound fields follow it.
void Mixer_set_listener(*Mixer self, AudioVec3 position, AudioVec3 forward, AudioVec3 up) {
    self.listener = position;
    self.listener_forward = _v3_unit(forward);
    self.listener_up = _v3_unit(up);
    for (i in 0..self.voices.size) _voice_space(self, &self.voices.data[i]);
}

// Places the listener from a rotation: ahead is -z and up is y turned by rotation.
void Mixer_set_listener_pose(*Mixer self, AudioVec3 position, AudioQuat rotation) {
    Mixer_set_listener(self, position, _quat_rotate(rotation, AudioVec3{0.0, 0.0, -1.0}), _quat_rotate(rotation, AudioVec3{0.0, 1.0, 0.0}));
}

// Starts sound at position (ViroReact's ViroSpatialSound): its channels mixed to one,
// panned by where it is around the listener and faded by distance with the voice's rolloff
// (none until Mixer_set_rolloff). opt.pan does not apply.
uint32 Mixer_play_at(*Mixer self, *Sound sound, AudioPlay opt, AudioVec3 position) {
    uint32 id = Mixer_play(self, sound, opt);
    _Voice* v = _mixer_voice(self, id);
    v.space = _SPACE_POINT;
    v.position = position;
    v.min_distance = 1.0;
    v.max_distance = 10.0;
    _voice_space(self, v);
    return id;
}

// Moves a positioned sound.
void Mixer_set_position(*Mixer self, uint32 id, AudioVec3 position) {
    _Voice* v = _mixer_voice(self, id);
    if (v == null || v.space != _SPACE_POINT) return;
    v.position = position;
    _voice_space(self, v);
}

// Sets how a positioned sound fades with distance: an AUDIO_ROLLOFF_ model, the distance
// where fading starts and the one where it reaches silence.
void Mixer_set_rolloff(*Mixer self, uint32 id, int model, float min_distance, float max_distance) {
    _Voice* v = _mixer_voice(self, id);
    if (v == null || v.space != _SPACE_POINT) return;
    v.rolloff = model;
    v.min_distance = min_distance;
    v.max_distance = max_distance;
    _voice_space(self, v);
}

// Starts a first-order ambisonic sound (ViroReact's ViroSoundField): four channels in AmbiX
// order (W, Y, Z, X), turned by rotation, heard from the listener's orientation. A sound
// with fewer channels plays as an ordinary one.
uint32 Mixer_play_field(*Mixer self, *Sound sound, AudioPlay opt, AudioQuat rotation) {
    uint32 id = Mixer_play(self, sound, opt);
    if (sound.channels < 4) return id;
    _Voice* v = _mixer_voice(self, id);
    v.space = _SPACE_FIELD;
    v.field_rotation = rotation;
    _voice_space(self, v);
    return id;
}

// Turns a sound field.
void Mixer_set_field_rotation(*Mixer self, uint32 id, AudioQuat rotation) {
    _Voice* v = _mixer_voice(self, id);
    if (v == null || v.space != _SPACE_FIELD) return;
    v.field_rotation = rotation;
    _voice_space(self, v);
}

// Stops every voice and frees the mixer's lists; the sounds it played are the caller's.
void Mixer_free(*Mixer self) {
    Mixer_stop_all(self);
    List_free(&self.voices);
    List_free(&self.buses);
}
