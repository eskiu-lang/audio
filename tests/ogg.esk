// Ogg Vorbis decoding against libvorbisfile's decoding of the same files (made by
// tools/gen_test_audio.sh), exact seeking, loop points, streams through the mixer and
// damaged files.
import <io>;
import <mem>;
import <string>;
import <fs>;
import <libc>;
import <audio/ogg>;
import <audio/mixer>;
import <audio/decode>;

int fails = 0;

void fail(string what) {
    printf("FAIL %s\n", what);
    fails++;
}

*float load_f32(string name, *int64 count) {
    String path;
    defer String_free(&path);
    String_appendf(&path, "tests/data/%s.f32", name);
    int64 n = 0;
    *float want = (*float)fs_read_all(path.data, &n);
    *count = n / 4;
    return want;
}

void compare(string name, int channels, int rate) {
    String path;
    defer String_free(&path);
    String_appendf(&path, "tests/data/%s.ogg", name);
    Result<Sound, string> r = ogg_load(path.data);
    if (!r.ok) {
        printf("FAIL %s: %s\n", name, r.error);
        fails++;
        return;
    }
    Sound s = r.value;
    defer s.free();
    int64 count = 0;
    *float want = load_f32(name, &count);
    defer free(want);
    if (s.channels != channels || s.rate != rate) {
        printf("FAIL %s: %d channels at %d Hz\n", name, s.channels, s.rate);
        fails++;
    }
    if ((int64)(s.frames * (uint64)s.channels) != count) {
        printf("FAIL %s: %llu samples, want %lld\n", name, s.frames * (uint64)s.channels, count);
        fails++;
        return;
    }
    float worst = 0.0;
    for (i in 0..count) {
        float d = fabsf(s.data[i] - want[i]);
        if (d > worst) worst = d;
    }
    // libvorbisfile and this decoder round differently in the transform: within 2^-20.
    if (worst > 0.000001) {
        printf("FAIL %s: max error %g\n", name, (double)worst);
        fails++;
    }
}

// Every seek reads exactly the frames a decode from the start gives there.
void seeks(string name) {
    String path;
    defer String_free(&path);
    String_appendf(&path, "tests/data/%s.ogg", name);
    Sound all = ogg_load(path.data).value;
    defer all.free();
    OggVorbis f = ogg_open(path.data).value;
    defer f.free();
    int ch = f.channels;
    *float got = alloc<float>(400 * (int64)ch);
    defer free(got);
    uint64[12] at = {0, 1, 63, 64, 127, 128, 129, 1000, 1023, 1024, 1025, 3333};
    for (k in 0..16) {
        uint64 frame = k < 12 ? at[k] : f.frames - (uint64)(k - 11) * 7;
        if (frame >= f.frames) continue;
        f.seek(frame);
        if (f.tell() != frame) fail("tell after seek");
        int64 n = f.read(got, 400);
        int64 expect = f.frames - frame < 400 ? (int64)(f.frames - frame) : 400;
        if (n != expect) {
            printf("FAIL %s: seek to %llu read %lld frames, want %lld\n", name, frame, n, expect);
            fails++;
            continue;
        }
        for (i in 0..n * (int64)ch) {
            if (got[i] != all.data[frame * (uint64)ch + (uint64)i]) {
                printf("FAIL %s: seek to %llu differs at %lld\n", name, frame, i);
                fails++;
                break;
            }
        }
    }
    f.seek(f.frames);
    if (f.read(got, 10) != 0) fail("read past the end");
}

// The frames a looping voice or stream plays: the sound up to its loop end, then from its
// loop start to its loop end again and again (clipped to 1, as the mixer's output is).
float looped(*Sound s, int64 i) {
    int64 le = (int64)s.loop_end;
    int64 ls = (int64)s.loop_start;
    int64 at = i < le ? i : ls + (i - le) % (le - ls);
    float v = s.data[at];
    return v > 1.0 ? 1.0 : (v < -1.0 ? -1.0 : v);
}

void loops() {
    Sound s = ogg_load("tests/data/ogg_loop.ogg").value;
    defer s.free();
    if (s.loop_start != 2000 || s.loop_end != 7000) {
        printf("FAIL loop points %llu..%llu\n", s.loop_start, s.loop_end);
        fails++;
        return;
    }
    int64 n = 30000;
    *float out = alloc<float>(n * 2);
    defer free(out);

    // A Sound with loop points, as a voice plays it.
    Mixer m = mixer_new(s.rate);
    m.play(&s, AudioPlay{loop: true, balance: true});
    m.render(out, (int)n);
    m.free();
    for (i in 0..n) {
        if (out[i * 2] != looped(&s, i) || out[i * 2 + 1] != looped(&s, i)) {
            printf("FAIL looping voice at frame %lld\n", i);
            fails++;
            break;
        }
    }

    // The same file as a stream, rendered in blocks of different sizes.
    for (block in 0..3) {
        int[3] sizes = {512, 7, 4096};
        OggStream st = ogg_stream("tests/data/ogg_loop.ogg", s.rate, true).value;
        Mixer mm = mixer_new(s.rate);
        uint32 id = mm.play_source(&st, AudioPlay{bus: AUDIO_BUS_MUSIC});
        int64 done = 0;
        while (done < n) {
            int64 k = n - done < (int64)sizes[block] ? n - done : (int64)sizes[block];
            mm.render(out + done * 2, (int)k);
            done += k;
        }
        if (!mm.playing(id)) fail("a looping stream ended");
        mm.free();
        st.free();
        for (i in 0..n) {
            if (out[i * 2] != looped(&s, i) || out[i * 2 + 1] != looped(&s, i)) {
                printf("FAIL looping stream (blocks of %d) at frame %lld\n", sizes[block], (int64)i);
                fails++;
                break;
            }
        }
    }
}

void streams() {
    Sound s = ogg_load("tests/data/ogg_stereo.ogg").value;
    defer s.free();
    int64 total = (int64)s.frames;

    // Once through at the file's rate: the decoded frames, then done.
    OggStream st = ogg_stream("tests/data/ogg_stereo.ogg", s.rate, false).value;
    *float out = alloc<float>((total + 1000) * 2);
    defer free(out);
    int64 got = 0;
    while (!st.done()) {
        int64 n = st.render(out + got * 2, 333);
        got += n;
        if (n == 0) break;
    }
    if (got != total) {
        printf("FAIL stream gave %lld frames, want %lld\n", got, total);
        fails++;
    }
    for (i in 0..total * 2) {
        if (out[i] != s.data[i]) {
            fail("stream differs from the decoded file");
            break;
        }
    }

    // Seeking a stream, and its position.
    st.seek(0.25);
    double at = st.position();
    if (fabs(at - 11025.0 / 44100.0) > 0.000001) {
        printf("FAIL stream position %g after a seek to 0.25\n", at);
        fails++;
    }
    float[4] two;
    st.render(&two[0], 2);
    if (two[0] != s.data[11025 * 2] || two[3] != s.data[11026 * 2 + 1]) fail("stream seek");
    st.free();

    // At twice the file's rate: every other frame is the file's, the ones between halfway.
    OggStream up = ogg_stream("tests/data/ogg_stereo.ogg", s.rate * 2, false).value;
    int64 n = up.render(out, 4000);
    up.free();
    if (n != 4000) fail("resampled stream length");
    for (i in 0..1999) {
        float mid = s.data[i * 2] + (s.data[i * 2 + 2] - s.data[i * 2]) * 0.5;
        if (out[i * 4] != s.data[i * 2] || out[i * 4 + 2] != mid) {
            printf("FAIL resampled stream at frame %d\n", i);
            fails++;
            break;
        }
    }

    // A mono file plays on both sides.
    Sound mono = ogg_load("tests/data/ogg_mono.ogg").value;
    OggStream ms = ogg_stream("tests/data/ogg_mono.ogg", mono.rate, false).value;
    n = ms.render(out, 5000);
    ms.free();
    if (n != (int64)mono.frames) fail("mono stream length");
    for (i in 0..n) {
        if (out[i * 2] != mono.data[i] || out[i * 2 + 1] != mono.data[i]) {
            fail("mono stream");
            break;
        }
    }
    mono.free();
}

// The same calls give the same bytes, run after run.
void determinism() {
    *float a = alloc<float>(20000);
    *float b = alloc<float>(20000);
    defer free(a);
    defer free(b);
    for (run in 0..2) {
        OggStream st = ogg_stream("tests/data/ogg_ffmpeg.ogg", 48000, true).value;
        Mixer m = mixer_new(48000);
        m.use_bgm(m.play_source(&st, AudioPlay{bus: AUDIO_BUS_MUSIC}), 100);
        m.render(run == 0 ? a : b, 10000);
        m.free();
        st.free();
    }
    if (memcmp(a, b, 80000) != 0) fail("two runs of a stream differ");
}

void damaged() {
    int64 len = 0;
    *uint8 file = fs_read_all("tests/data/ogg_stereo.ogg", &len);
    defer free(file);
    *float out = alloc<float>(8192);
    defer free(out);
    uint32 seed = 5;
    for (round in 0..400) {
        *uint8 copy = alloc<uint8>(len);
        memcpy(copy, file, len);
        int64 cut = len;
        if (round < 200) cut = (int64)round * len / 200;
        else {
            for (k in 0..4) {
                seed = seed * 1103515245 + 12345;
                copy[(int64)(seed >> 8) % len] = (uint8)(seed >> 3);
            }
        }
        Result<OggVorbis, string> r = ogg_open_memory(copy, (uint64)cut);
        free(copy);
        if (!r.ok) continue;
        OggVorbis f = r.value;
        while (f.read(out, 1000) > 0) {}
        f.seek(f.frames / 2);
        (void)f.read(out, 1000);
        f.free();
    }
}

int main() {
    compare("ogg_mono", 1, 22050);
    compare("ogg_stereo", 2, 44100);
    compare("ogg_51", 6, 48000);
    compare("ogg_silent", 2, 44100);
    compare("ogg_tiny", 1, 44100);
    compare("ogg_loop", 1, 22050);
    compare("ogg_ffmpeg", 2, 22050);
    seeks("ogg_stereo");
    seeks("ogg_loop");
    seeks("ogg_51");
    seeks("ogg_ffmpeg");
    loops();
    streams();
    determinism();
    damaged();

    Result<Sound, string> s = sound_load("tests/data/ogg_mono.ogg");
    if (!s.ok || s.value.frames != 1103) fail("sound_load of an .ogg file");
    else s.value.free();
    if (ogg_load("tests/data/s16.wav").ok) fail("a WAV file opened as Ogg Vorbis");
    if (ogg_load("tests/data/missing.ogg").ok) fail("a missing file");

    printf("ogg: %d failures\n", fails);
    return fails == 0 ? 0 : 1;
}
